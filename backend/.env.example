# ─────────────────────────────────────────────────────
# ENGINES JDS — Backend environment variables
# Copiar este archivo a .env y completar los valores.
# ─────────────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development
# Separa con coma si necesitas múltiples orígenes (red local)
# En desarrollo, cualquier IP local (192.168.x.x) es aceptada automáticamente
FRONTEND_URL=http://localhost:5173

# ── MySQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=engines_jds
DB_CONNECTION_LIMIT=10

# ── JWT ───────────────────────────────────────────────
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_in_production
# Access token (corto) y refresh token (largo)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Compatibilidad: usado como fallback histórico
JWT_EXPIRES_IN=15m

# ── Bcrypt ────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Bloqueo de login por IP ───────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── Logging ───────────────────────────────────────────
# Niveles: error | warn | info | debug
LOG_LEVEL=info
