# ─────────────────────────────────────────────────────
# ENGINES JDS — Backend environment variables
# Copiar este archivo a .env y completar los valores.
# ─────────────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development
# Separa con coma si necesitas múltiples orígenes (red local)
# En desarrollo, cualquier IP local (192.168.x.x) es aceptada automáticamente
FRONTEND_URL=http://localhost:5173

# ── MySQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=engines_jds
# En Vercel: baja este valor (ej. 3) — cada invocación serverless abre su propio pool
DB_CONNECTION_LIMIT=10
# true si el proveedor exige TLS (ej. Aiven). En local con MySQL propio, déjalo en false.
DB_SSL=false
# Certificado CA del proveedor (contenido PEM completo) — opcional pero recomendado:
# con él se verifica la identidad del servidor; sin él la conexión va cifrada sin verificación.
DB_SSL_CA=

# ── Vercel Blob (subida de logo) ──────────────────────
# Se genera automáticamente al conectar un Blob Store en el dashboard de Vercel
BLOB_READ_WRITE_TOKEN=

# ── JWT ───────────────────────────────────────────────
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_in_production
# Access token (corto) y refresh token (largo)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Compatibilidad: usado como fallback histórico
JWT_EXPIRES_IN=15m

# ── Bcrypt ────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Bloqueo de login por IP ───────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── Email / SMTP (recuperación de contraseña) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=ENGINES JDS <your_email@gmail.com>

# ── Recuperación de contraseña (OTP) ──────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Logging ───────────────────────────────────────────
# Niveles: error | warn | info | debug
LOG_LEVEL=info
