# ─────────────────────────────────────────────────────
# SGTM — Variables de entorno del backend
# Copiar este archivo a .env y completar los valores.
# ─────────────────────────────────────────────────────

# Servidor
PORT=3000
NODE_ENV=development
# Separa con coma si necesitas múltiples orígenes (red local)
# En desarrollo, cualquier IP local (192.168.x.x) es aceptada automáticamente
FRONTEND_URL=http://localhost:5173

# ── MySQL ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=engines_jds
# En Vercel: baja este valor (ej. 3) — cada invocación serverless abre su propio pool
DB_CONNECTION_LIMIT=10
# Límite por base tenant para no multiplicar conexiones al crecer el número de talleres
TENANT_DB_CONNECTION_LIMIT=5
# true si el proveedor exige TLS (ej. Aiven). En local con MySQL propio, déjalo en false.
DB_SSL=false
# Certificado CA del proveedor (contenido PEM completo) — opcional pero recomendado:
# con él se verifica la identidad del servidor; sin él la conexión va cifrada sin verificación.
DB_SSL_CA=

# Respaldos manuales: solo aptos para infraestructura propia con filesystem
# persistente y clientes mysqldump/mysql instalados. Vercel los deshabilita.
BACKUP_MANUAL_ENABLED=true
# Restaurar es destructivo y queda deshabilitado salvo habilitación explícita.
BACKUP_RESTORE_ENABLED=false
# Etiqueta opcional no sensible. Ejemplo: aiven.
DATABASE_PROVIDER=

# ── Vercel Blob (subida de logo) ──────────────────────
# Se genera automáticamente al conectar un Blob Store en el dashboard de Vercel
BLOB_READ_WRITE_TOKEN=

# ── JWT ───────────────────────────────────────────────
# Genera un secreto seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret_in_production
# Access token (corto) y refresh token (largo)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Compatibilidad: usado como fallback histórico
JWT_EXPIRES_IN=15m

# ── Sesiones y cookies ───────────────────────────────
# 300 minutos = 5 horas desde la última actividad válida.
# Para pruebas puede usarse temporalmente SESSION_IDLE_TIMEOUT_MINUTES=1.
SESSION_IDLE_TIMEOUT_MINUTES=300
# Evita escribir last_activity en BD en cada petición autenticada.
SESSION_ACTIVITY_UPDATE_MINUTES=5
# Producción usa frontend/API en dominios separados; requiere None + Secure.
# En despliegues same-site puede cambiarse a lax.
AUTH_COOKIE_SAME_SITE=none
# Opcional. Déjalo vacío para usar cookies host-only del dominio de la API.
AUTH_COOKIE_DOMAIN=

# ── Bcrypt ────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Plataforma SaaS multi-taller ─────────────────────
# Déjalo en false para conservar el modo actual de un solo taller.
SAAS_ENABLED=false
SAAS_TRIAL_DAYS=14
# Base separada con tenants, cuentas y suscripciones.
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=your_password_here
PLATFORM_DB_NAME=engines_platform
PLATFORM_DB_CONNECTION_LIMIT=5
PLATFORM_DB_SSL=false
PLATFORM_DB_SSL_CA=
# Usuario con privilegio CREATE DATABASE para aprovisionar tenants.
# Si se omiten host/puerto/usuario/contraseña, se usan los de PLATFORM_DB.
PROVISIONER_DB_HOST=localhost
PROVISIONER_DB_PORT=3306
PROVISIONER_DB_USER=root
PROVISIONER_DB_PASSWORD=your_password_here

# Stripe: opcional mientras se usa el período de prueba
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://enginesjds.com/admin/suscripcion?billing=success
BILLING_CANCEL_URL=https://enginesjds.com/admin/suscripcion?billing=cancelled

# ── Bloqueo de login por IP ───────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── Email / SMTP (recuperación de contraseña) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=SGTM <your_email@gmail.com>

# ── Recuperación de contraseña (OTP) ──────────────────
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Logging ───────────────────────────────────────────
# Niveles: error | warn | info | debug
LOG_LEVEL=info
